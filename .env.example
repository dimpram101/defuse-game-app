# Postgres. Dev: `bun run db:up` starts it on port 5434.
DATABASE_URL=postgres://defuse:defuse@localhost:5434/defuse
# GM panel PIN, at least 6 characters.
GM_PIN=change-me
# URL phones open from the QR code. Use the laptop's LAN IP in dev, the HTTPS subdomain in production.
PUBLIC_URL=http://localhost:5173
PORT=3001

# Production only (docker-compose.yml)
DOMAIN=defuse.example.com
POSTGRES_PASSWORD=change-me-too
